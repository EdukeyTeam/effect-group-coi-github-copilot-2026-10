{
  "servers": {
    "io.github.upstash/context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "requestInit": {
        "headers": {
          "Authorization": ""
        }
      },
      "x-metadata": {
        "registry": {
          "api": {
            "baseUrl": "https://api.mcp.github.com",
            "version": "v0.1"
          },
          "mcpServer": {
            "name": "io.github.upstash/context7",
            "version": "4.4.4"
          }
        }
      }
    },
    "io.github.ChromeDevTools/chrome-devtools-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.12.0"
      ],
      "x-metadata": {
        "registry": {
          "api": {
            "baseUrl": "https://api.mcp.github.com",
            "version": "v0.1"
          },
          "mcpServer": {
            "name": "io.github.ChromeDevTools/chrome-devtools-mcp",
            "version": "1.12.0"
          }
        }
      }
    }
  }
}