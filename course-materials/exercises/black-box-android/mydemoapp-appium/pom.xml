<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>pl.kurs.qa</groupId>
    <artifactId>mydemoapp-appium</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>mydemoapp-appium</name>
    <description>Black-box Android smoke tests for Sauce Labs My Demo App 2.3.0 (Appium 3, UiAutomator2)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <!-- java-client 11 requires Appium 3 and brings only selenium-api.
             Explicit WebDriverWait/ExpectedConditions need selenium-support. -->
        <appium-java-client.version>11.0.0</appium-java-client.version>
        <selenium.version>4.51.0</selenium.version>
        <testng.version>7.12.0</testng.version>
        <!-- Surefire 3.6.x dropped TestNG suite XML support (TestNG runs on the
             JUnit Platform there and cannot read testng.xml). Stay on the latest
             3.5.x line while the course uses a TestNG suite file. -->
        <surefire.version>3.5.6</surefire.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Keep support and Appium's selenium-api on the same version. -->
            <dependency>
                <groupId>org.seleniumhq.selenium</groupId>
                <artifactId>selenium-bom</artifactId>
                <version>${selenium.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.appium</groupId>
            <artifactId>java-client</artifactId>
            <version>${appium-java-client.version}</version>
        </dependency>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>testng.xml</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
